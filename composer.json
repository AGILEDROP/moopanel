{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "arsanchez/laravel-azure-provisioning": "^1.1.10",
        "codewithdennis/filament-select-tree": "^3.1",
        "filament/filament": "^3.0-stable",
        "flowframe/laravel-trend": "^0.2.0",
        "guzzlehttp/guzzle": "^7.2",
        "hydrat/filament-table-layout-toggle": "^1.2",
        "jfcherng/php-diff": "^6.16",
        "laravel/framework": "^v11.51.0",
        "laravel/sanctum": "^v4.3.2",
        "laravel/socialite": "^5.27",
        "laravel/tinker": "^v3.0.2",
        "owenvoke/blade-fontawesome": "^2.5",
        "saade/filament-laravel-log": "^3.0",
        "socialiteproviders/microsoft-azure": "^5.1",
        "symfony/filesystem": "^7.0",
        "z3d0x/filament-logger": "^0.7.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^v1.29.1",
        "laravel/sail": "^v1.58.0",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^v8.9.4",
        "phpunit/phpunit": "^11.5.55",
        "spatie/laravel-ignition": "^2.12.0"
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
